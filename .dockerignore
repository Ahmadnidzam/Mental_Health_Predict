# Folder vendor & node_modules akan di-install ulang di container
vendor/
node_modules/
public/build/
public/hot/

# File local dev yang tidak perlu di image
.env
.env.local
.env.backup
.env.production
.git
.github
.idea
.vscode
.fleet
.nova
.zed

# Cache & log
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Model artifacts (akan di-train ulang saat first deploy via entrypoint)
storage/models/*.pkl
storage/models/train_results.json
storage/models/train_results.txt
storage/models/__pycache__/

# Database SQLite (kita pakai MySQL di production)
database/database.sqlite
database/database.sqlite-journal

# File dokumentasi & rules yang tidak perlu di production
rules/
rules.zip
notebooks/
SETUP.md

# Test files
tests/
phpunit.xml
.phpunit.cache/
.phpunit.result.cache

# Misc
.DS_Store
Thumbs.db
*.log
